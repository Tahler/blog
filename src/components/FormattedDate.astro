---
interface Props {
  date: Date | `${number}-${number}-${number}`;
}

const { date } = Astro.props;
const value = new Date(date);
---

<time datetime={value.toISOString()}>
  {
    value.toLocaleDateString("en-us", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  }
</time>
