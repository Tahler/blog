---

---

<nav aria-label="Primary">
  <a href="/about" id="about-link" class="item">
    <kbd>A</kbd><span class="suffix">bout</span>
  </a>
  <a href="/blog" id="blog-link" class="item">
    <kbd>B</kbd><span class="suffix">log</span>
  </a>
  <a href="/contact" id="contact-link" class="item">
    <kbd>C</kbd><span class="suffix">ontact</span>
  </a>
  <button
    id="theme-toggle"
    type="button"
    aria-label="Toggle color theme"
    class="item"
  >
    <kbd>D</kbd><span class="suffix">ark</span>
  </button>
</nav>

<script is:inline>
  function syncThemeButton(theme, button) {
    const activeTheme = theme.getTheme();
    button.setAttribute("aria-pressed", String(activeTheme === "dark"));
    button.setAttribute(
      "aria-label",
      `Switch to ${activeTheme === "dark" ? "light" : "dark"} mode`,
    );
  }

  function toggleTheme(theme, button) {
    const other = theme.getTheme() === "dark" ? "light" : "dark";
    theme.setTheme(other);
    syncThemeButton(theme, button);
  }

  function isTypingTarget(target) {
    return (
      target instanceof HTMLElement &&
      (target.isContentEditable ||
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        target instanceof HTMLSelectElement)
    );
  }

  function addKeyTrigger(element, key) {
    document.addEventListener("keydown", (event) => {
      if (
        isTypingTarget(event.target) ||
        event.altKey ||
        event.ctrlKey ||
        event.metaKey ||
        event.shiftKey
      ) {
        return;
      }
      if (event.key.toLowerCase() !== key) {
        return;
      }
      event.preventDefault();
      element.click();
    });
  }

  function initializeThemeToggle() {
    const theme = window.__theme;
    const toggle = document.getElementById("theme-toggle");
    if (!theme || !(toggle instanceof HTMLButtonElement)) {
      return;
    }

    syncThemeButton(theme, toggle);
    toggle.addEventListener("click", () => {
      toggleTheme(theme, toggle);
    });

    addKeyTrigger(toggle, "d");

    theme.mediaQuery.addEventListener("change", (event) => {
      if (theme.readStoredTheme()) {
        return;
      }

      const mode = event.matches ? "dark" : "light";
      theme.applyTheme(mode);
      syncThemeButton(theme, toggle);
    });
  }

  initializeThemeToggle();
  addKeyTrigger(document.getElementById("about-link"), "a");
  addKeyTrigger(document.getElementById("blog-link"), "b");
  addKeyTrigger(document.getElementById("contact-link"), "c");
</script>

<style>
  nav {
    margin: 1rem 0 1rem 1rem;
    display: flex;
    justify-content: end;
    gap: 1rem;
  }

  .item {
    font: inherit;
    color: var(--color-tx-muted);
    cursor: pointer;
    background: transparent;
    text-decoration: none;
    margin: 0;
    padding: 0.25rem 0.5rem;
    border: 0;
    border-radius: 0.25rem;

    &:hover,
    &:focus-visible {
      color: var(--color-action);
    }

    &:active {
      background: var(--color-selection);
    }
  }

  kbd {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-tx-faint);
    text-decoration-thickness: 0;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 720px) {
    .suffix {
      display: none;
    }
  }
</style>
