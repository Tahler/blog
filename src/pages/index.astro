---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main>
    <h1>Hey it's Tyler 👋</h1>
    <p>Subscribe below to stay in touch and receive new post notifications!</p>
    <form method="post" action="/subscribe">
      <input
        type="email"
        name="email"
        placeholder="me@gmail.com"
        autocomplete="email"
        required
      />
      <button type="submit">Subscribe</button>
    </form>
  </main>
  <footer>
    <Nav />
  </footer>
</BaseLayout>

<style>
  body {
    box-sizing: border-box;
    min-height: 100svh;

    display: flex;
    flex-direction: column;
  }

  main {
    margin: 0 1rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  footer {
    margin: 1rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 11vw, 4rem);
    color: inherit;
  }

  p {
    margin: 0;
    color: var(--color-tx-muted);
    width: min(100%, 30rem);
    font-size: 1rem;
  }

  form {
    width: min(100%, 30rem);
    display: flex;

    &:focus-within input {
      border-color: var(--color-action);
    }
  }

  input,
  button {
    font: inherit;

    &:focus {
      outline: none;
    }
  }

  input {
    width: 0;
    flex: auto;
    padding: 0.8rem 1rem;

    background: var(--color-bg-secondary);
    color: var(--color-tx-normal);
    transition: border-color 150ms ease;

    border: 1px solid var(--color-ui-normal);
    border-top-left-radius: 0.25rem;
    border-bottom-left-radius: 0.25rem;
    border-right: none;

    &::placeholder {
      color: var(--color-tx-faint);
    }

    &:hover {
      border-color: var(--color-ui-hover);
    }

    &:focus {
      border-color: var(--color-action);
    }
  }

  button {
    flex: none;
    padding: 0.5rem 1rem;
    cursor: pointer;
    white-space: nowrap;
    background: var(--color-tx-normal);
    color: var(--color-bg-primary);
    transition: background-color 150ms ease;

    border: none;
    border-top-right-radius: 0.25rem;
    border-bottom-right-radius: 0.25rem;

    &:hover,
    &:focus {
      background: var(--color-action);
    }
  }
</style>
