---
import { SITE_DESCRIPTION } from "../../consts";
import Tag from "../../components/Tag.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import { getSortedPosts } from "../../lib/posts";

export const prerender = false;

const posts = await getSortedPosts();
const tags = [...new Set(posts.map((post) => post.tag))].sort();
const selectedTag = Astro.url.searchParams.get("tag");
const activeTag = tags.includes(selectedTag as (typeof tags)[number])
  ? selectedTag
  : null;
const filteredPosts = activeTag
  ? posts.filter((post) => post.tag === activeTag)
  : posts;
---

<PageLayout title="Blog" description={SITE_DESCRIPTION}>
  <main>
    <nav aria-label="Filter posts by tag">
      <Tag value="all" active={!activeTag} />
      {tags.map((tag) => <Tag value={tag} active={activeTag === tag} />)}
    </nav>
    <ul>
      {
        filteredPosts.map((post) => (
          <li>
            <a href={post.url}>
              <time datetime={post.date}>{post.date}</time>
              <span>{post.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</PageLayout>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
  }
  a {
    text-decoration: none;
    transition: 150ms ease;
    color: inherit;

    &:hover {
      color: var(--color-action);
    }
  }
  time {
    padding-right: 0.5rem;
    color: var(--color-tx-muted);
  }
</style>
