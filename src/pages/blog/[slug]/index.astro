---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Tag from "../../../components/Tag.astro";
import PageLayout from "../../../layouts/PageLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);

const { title, description, date, tag } = post.data;
const replyHref = `mailto:tyler@bertyl.com?subject=${encodeURIComponent(`Re: ${title}`)}`;
const breadcrumbs = [{ title: "Blog", href: "/blog" }];
---

<PageLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <main>
    <article>
      <header>
        <h1>{title}</h1>
        <div class="meta">
          <time datetime={date}>{date}</time>
          <Tag value={tag} />
        </div>
      </header>
      <Content />
    </article>
  </main>
  <hr />
  <footer>
    <blockquote>
      <p><a href={replyHref}>Reply by email</a></p>
      <p>Published {date}</p>
    </blockquote>
  </footer>
</PageLayout>

<style>
  header {
    margin-bottom: 2em;
  }

  .meta {
    display: flex;
    gap: 1rem;
    color: var(--color-tx-muted);
  }

  footer {
    margin: 4rem 0;

    blockquote {
      background: var(--color-bg-secondary);
      padding: 1rem;

      p {
        margin: 0;
      }
    }
  }
</style>
