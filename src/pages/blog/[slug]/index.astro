---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Tag from "../../../components/Tag.astro";
import PageLayout from "../../../layouts/PageLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);

const { title, description, date, tag, image, imageAlt } = post.data;
const replyHref = `mailto:tyler@bertyl.com?subject=${encodeURIComponent(`Re: ${title}`)}`;
const breadcrumbs = [{ title: "Blog", href: "/blog" }];
---

<PageLayout
  title={title}
  description={description}
  image={image}
  imageAlt={image ? (imageAlt ?? title) : "Hey it's Tyler"}
  ogType="article"
  publishedTime={date}
  breadcrumbs={breadcrumbs}
>
  <main>
    <article>
      <header>
        <h1>{title}</h1>
        <div class="meta">
          <time datetime={date}>{date}</time>
          <Tag value={tag} />
        </div>
      </header>
      <Content />
    </article>
  </main>
  <hr />
  <footer>
    <blockquote>
      <p><a href={replyHref}>Reply by email</a></p>
      <p>Published {date}</p>
    </blockquote>
  </footer>
</PageLayout>

<style>
  header {
    margin-bottom: 2em;

    h1 {
      color: var(--color-action);
    }
  }

  .meta {
    display: flex;
    gap: 1rem;
    color: var(--color-tx-muted);
  }

  :global(article) {
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    [data-footnote-ref] {
      padding: 0 0.1em;
      color: var(--color-action);
      font-weight: 600;
      text-decoration-line: none;

      &:hover,
      &:focus-visible {
        text-decoration-color: var(--color-tx-faint);
        text-decoration-line: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.25rem;
      }
    }

    .footnotes {
      padding-top: 1rem;
      margin-top: 2.5rem;
      border-top: 1px solid var(--color-ui-normal);
      color: var(--color-tx-muted);
      font-size: 0.875em;
      line-height: 1.55;

      ol {
        list-style: none;
        margin: 0;
        padding-left: 1.75rem;
      }

      li {
        position: relative;
        padding-left: 0.25rem;
      }

      p {
        margin: 0 0 0.75rem;
      }

      [data-footnote-backref] {
        text-decoration-line: none;

        &::before {
          position: absolute;
          top: 0;
          left: -1.5rem;
          width: 1.25rem;
          content: counter(list-item);
          text-align: right;
          text-decoration-color: var(--color-tx-faint);
          text-decoration-line: underline;
          text-decoration-style: dashed;
          text-decoration-thickness: 1px;
          text-underline-offset: 0.25rem;
        }

        &:hover::before,
        &:focus-visible::before {
          text-decoration-style: solid;
        }

        ~ [data-footnote-backref]::before {
          display: none;
        }
      }
    }

    video {
      width: 100%;
      border-radius: 0.25rem;
    }

    .gallery {
      --gallery-gap: clamp(0.35rem, 1vw, 0.75rem);

      position: relative;
      left: 50%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gallery-gap);
      width: min(var(--wrap-wide), calc(100vw - 2rem));
      margin: 2.5rem 0 3rem;
      transform: translateX(-50%);

      .column {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: var(--gallery-gap);
      }

      p {
        display: grid;
        gap: var(--gallery-gap);
        margin: 0;
      }

      img {
        display: block;
        width: 100%;
        margin: 0;
        background: linear-gradient(
          110deg,
          var(--color-bg-secondary) 30%,
          var(--color-ui-normal) 45%,
          var(--color-bg-secondary) 60%
        );
        background-size: 200% 100%;
        animation: gallery-skeleton 1.8s ease-in-out infinite;
      }

      @media (prefers-reduced-motion: reduce) {
        img {
          animation: none;
        }
      }
    }
  }

  @keyframes gallery-skeleton {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }

  footer {
    margin: 4rem 0;

    blockquote {
      background: var(--color-bg-secondary);
      padding: 1rem;

      p {
        margin: 0;
      }
    }
  }
</style>
