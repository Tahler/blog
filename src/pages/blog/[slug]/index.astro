---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Tag from "../../../components/Tag.astro";
import PageLayout from "../../../layouts/PageLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);

const { title, description, date, tag } = post.data;
const replyHref = `mailto:tyler@bertyl.com?subject=${encodeURIComponent(`Re: ${title}`)}`;
const breadcrumbs = [{ title: "Blog", href: "/blog" }];
---

<PageLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <main>
    <article>
      <header>
        <h1>{title}</h1>
        <div class="meta">
          <time datetime={date}>{date}</time>
          <Tag value={tag} />
        </div>
      </header>
      <Content />
    </article>
  </main>
  <hr />
  <footer>
    <blockquote>
      <p><a href={replyHref}>Reply by email</a></p>
      <p>Published {date}</p>
    </blockquote>
  </footer>
</PageLayout>

<style>
  header {
    margin-bottom: 2em;

    h1 {
      color: var(--color-action);
    }
  }

  .meta {
    display: flex;
    gap: 1rem;
    color: var(--color-tx-muted);
  }

  :global(article) {
    video {
      width: 100%;
      border-radius: 0.25rem;
    }

    .gallery {
      --gallery-gap: clamp(0.35rem, 1vw, 0.75rem);

      position: relative;
      left: 50%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gallery-gap);
      width: min(var(--wrap-wide), calc(100vw - 2rem));
      margin: 2.5rem 0 3rem;
      transform: translateX(-50%);
    }

    .column {
      display: flex;
      min-width: 0;
      flex-direction: column;
      gap: var(--gallery-gap);
    }

  }

  :global(article .cdmx-gallery img) {
    display: block;
    width: 100%;
    margin: 0;
    background: linear-gradient(
      110deg,
      var(--color-bg-secondary) 30%,
      var(--color-ui-normal) 45%,
      var(--color-bg-secondary) 60%
    );
    background-size: 200% 100%;
    animation: cdmx-gallery-skeleton 1.8s ease-in-out infinite;
  }

  @keyframes cdmx-gallery-skeleton {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(article .cdmx-gallery img) {
      animation: none;
    }
  }

  footer {
    margin: 4rem 0;

    blockquote {
      background: var(--color-bg-secondary);
      padding: 1rem;

      p {
        margin: 0;
      }
    }
  }
</style>
