---
export const prerender = false;

import Nav from "../components/Nav.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  InvalidTokenError,
  subscriberService,
} from "../lib/subscriber-service";

let title = "";
let message = "";
const token = Astro.url.searchParams.get("t") ?? "";

if (Astro.request.method === "GET") {
  if (!token) {
    return Astro.redirect("/");
  }

  try {
    await subscriberService.confirm(token);
    const preferencesUrl = new URL("/preferences", Astro.url);
    preferencesUrl.searchParams.set("t", token);
    preferencesUrl.searchParams.set("confirmed", "1");
    return Astro.redirect(preferencesUrl.toString());
  } catch (error) {
    if (!(error instanceof InvalidTokenError)) {
      throw error;
    }
  }

  title = "Invalid link";
  message =
    "The confirmation link is invalid. Return home and subscribe again to receive a fresh link.";
} else if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const email = String(formData.get("email") ?? "");

  try {
    const confirmationUrl = new URL("/subscribe", Astro.url);
    await subscriberService.create(email, confirmationUrl);
    title = "Check your email";
    message =
      "Check your email for a confirmation link. If you don't receive an email, you might already be a subscriber.";
  } catch (error) {
    console.error(error);
    title = "Subscription failed";
    message = "Enter an email address and try again.";
  }
} else {
  return Astro.redirect("/");
}
---

<BaseLayout title={title} description={message}>
  <Nav />
  <main>
    <h1>{title}</h1>
    <p>{message}</p>
    <p><a href="/">Back home</a></p>
  </main>
</BaseLayout>
