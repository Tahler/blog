---
export const prerender = false;

import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { subscriberService } from '../lib/subscriber-service';

let title = '';
let message = '';
const token = Astro.url.searchParams.get('t') ?? '';

if (Astro.request.method === 'GET') {
	if (!token) {
		return Astro.redirect('/');
	}

	const valid = await subscriberService.confirmSubscriber(token);
  if (valid) {
    title = 'Subscription confirmed';
    message = "You're subscribed and will receive future posts by email.";
  } else {
    title = 'Invalid link';
    message = 'The confirmation link is invalid. Return home and subscribe again to receive a fresh link.';
  }
} else if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	const email = String(formData.get('email') ?? '');

	try {
		const confirmationUrl = new URL('/subscribe', Astro.url);
		await subscriberService.createPendingSubscriber(email, confirmationUrl);
		title = 'Check your email';
		message = "Check your email for a confirmation link. If you don't receive an email, you might already be a subscriber.";
	} catch (error) {
		console.error(error);
		title = 'Subscription failed';
		message = 'Enter an email address and try again.';
	}
} else {
	return Astro.redirect('/');
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={message} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{title}</h1>
			<p>{message}</p>
			<p><a href="/">Back home</a></p>
		</main>
		<Footer />
	</body>
</html>
