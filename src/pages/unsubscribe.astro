---
export const prerender = false;

import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { subscriberService } from '../lib/subscriber-service';

const token = Astro.url.searchParams.get('t') ?? '';
if (!token) {
	return Astro.redirect('/');
}

let title = 'Unsubscribe';
let message = 'Confirm that you want to unsubscribe from future emails.';
let unsubscribed = false;

if (Astro.request.method === 'POST') {
	try {
		const deleted = await subscriberService.unsubscribe(token);
		if (deleted) {
			title = 'You have been unsubscribed';
			message = 'Your subscriber account has been deleted and you will not receive future emails.';
			unsubscribed = true;
		} else {
			title = 'Invalid link';
			message = 'The unsubscribe link is invalid.';
		}
	} catch (error) {
		console.error(error);
		title = 'Error';
		message = 'Something went wrong.';
	}
} else if (Astro.request.method !== 'GET') {
	return Astro.redirect('/');
}

const subscriber = unsubscribed ? null : await subscriberService.readSubscriberByToken(token);
if (!unsubscribed && !subscriber) {
	title = 'Invalid link';
	message = 'The unsubscribe link is invalid.';
}

const email = subscriber?.email ?? '';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={message} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{title}</h1>
			<p>{message}</p>
			{
				subscriber ? (
					<form method="post">
						<p>
							<label>
								Email
								<input type="email" value={email} disabled />
							</label>
						</p>
						<p>
							<button type="submit">Confirm unsubscribe</button>
						</p>
					</form>
				) : (
					<p><a href="/">Back home</a></p>
				)
			}
		</main>
		<Footer />
	</body>
</html>
