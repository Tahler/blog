---
export const prerender = false;

import PageLayout from "../layouts/PageLayout.astro";
import {
  InvalidTokenError,
  subscriberService,
} from "../lib/subscriber-service";
import type { BlogPostTag } from "../lib/subscriber-store";

const token = Astro.url.searchParams.get("t") ?? "";
if (!token) {
  return Astro.redirect("/");
}

const tag = readTag(
  Astro.request.method === "POST"
    ? String((await Astro.request.clone().formData()).get("tag") ?? "")
    : Astro.url.searchParams.get("tag"),
);
const tagLabel = tag ? formatTag(tag) : "This Tag";

let title = "Unsubscribe";
let message = "";
let unsubscribed = false;

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const scope = String(formData.get("scope") ?? "all");

    if (scope === "tag" && tag) {
      await subscriberService.unsubscribeFromTag(token, tag);
      title = `You won't receive "${tagLabel}"`;
      message = "Your other email preferences are unchanged.";
    } else {
      await subscriberService.unsubscribe(token);
      title = "You have been unsubscribed";
      message =
        "Your subscriber account has been deleted and you will not receive future emails.";
    }

    unsubscribed = true;
  } catch (error) {
    if (error instanceof InvalidTokenError) {
      title = "Invalid link";
      message = "The unsubscribe link is invalid.";
    } else {
      console.error(error);
      title = "Error";
      message = "Something went wrong.";
    }
  }
} else if (Astro.request.method !== "GET") {
  return Astro.redirect("/");
}

let subscriber = null;
if (!unsubscribed) {
  try {
    subscriber = await subscriberService.readByToken(token);
  } catch (error) {
    if (error instanceof InvalidTokenError) {
      title = "Invalid link";
      message = "The unsubscribe link is invalid.";
    } else {
      throw error;
    }
  }
}

const email = subscriber?.email ?? "";

function readTag(value: string | null): BlogPostTag | null {
  if (value === "projects" || value === "thoughts" || value === "other") {
    return value;
  }
  return null;
}

function formatTag(value: BlogPostTag): string {
  const labels: Record<BlogPostTag, string> = {
    projects: "Projects",
    thoughts: "Thoughts",
    other: "Other",
  };
  return labels[value];
}
---

<PageLayout title={title} description={message}>
  <main>
    <h3>{title}</h3>
    <p>{message}</p>
    {
      subscriber ? (
        <form method="post">
          {tag && <input type="hidden" name="tag" value={tag} />}
          <fieldset class="table">
            <label>
              <span>Email</span>
              <input type="email" value={email} disabled />
            </label>
          </fieldset>
          <div class="actions">
            {tag && (
              <button type="submit" name="scope" value="tag">
                Unsubscribe from "{tagLabel}"
              </button>
            )}
            <button type="submit" name="scope" value="all">
              Unsubscribe from all emails
            </button>
          </div>
        </form>
      ) : (
        <p>
          <a href="/">Back home</a>
        </p>
      )
    }
  </main>
</PageLayout>

<style>
  p {
    margin-top: 0;
    color: var(--color-tx-muted);
  }

  form {
    margin-top: 2rem;
  }

  label {
    color: var(--color-tx-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: 0.5rem;
  }

  .table {
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 1rem;
  }

  .table label {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: center;
  }

  input:not([type="hidden"]) {
    width: 100%;
    padding: 0.25rem 0;
    border: 0;
    border-bottom: 1px solid var(--color-ui-normal);
    border-radius: 0;
    background: transparent;
    color: var(--color-tx-normal);
    font: inherit;

    &:disabled {
      color: var(--color-tx-muted);
    }

    &:focus {
      border-color: var(--color-action);
      outline: none;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  button {
    padding: 0.25rem 0.5rem;
    border: none;
    border-radius: 0.25rem;
    background: var(--color-tx-normal);
    color: var(--color-bg-primary);
    cursor: pointer;
    font: inherit;
    transition: background-color 150ms ease;

    &:hover,
    &:focus-visible {
      background: var(--color-action);
      outline: none;
    }
  }
</style>
