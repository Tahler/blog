---
export const prerender = false;

import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { subscriberService } from '../lib/subscriber-service';

const token = Astro.url.searchParams.get('t') ?? '';
if (!token) {
	return Astro.redirect('/');
}

let title = 'Manage preferences';
let message = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    await subscriberService.updatePreferences(token, {
      name: String(formData.get('name') ?? ''),
      wantsProjects: formData.get('wantsProjects') === 'on',
      wantsThoughts: formData.get('wantsThoughts') === 'on',
    });
		const preferencesUrl = new URL('/preferences', Astro.url);
		preferencesUrl.searchParams.set('t', token);
		preferencesUrl.searchParams.set('updated', '1');
		return Astro.redirect(preferencesUrl.toString());
	} catch (error) {
    console.error(error);
		title = 'Error';
		message = 'Something went wrong.';
	}
} else if (Astro.request.method !== 'GET') {
	return Astro.redirect('/');
}

const subscriber = await subscriberService.readSubscriberByToken(token);
if (!subscriber) {
	title = 'Invalid link';
	message = 'The token is invalid.';
}

if (subscriber) {
  if (Astro.url.searchParams.get('updated')) {
    message = 'Your preferences have been updated.';
  } else if (Astro.url.searchParams.get('confirmed')) {
    title = "You're subscribed";
    message = "It means a lot that you want to keep in touch. I'd love to know who's reading, so please add your name, especially if I wouldn't recognize you from your email :) Thanks for subscribing, and please feel free to reply directly to anything I send your way!";
  }
}

const name = subscriber?.name ?? '';
const email = subscriber?.email ?? '';
const wantsProjects = subscriber?.wantsProjects ?? false;
const wantsThoughts = subscriber?.wantsThoughts ?? false;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={message} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{title}</h1>
			<p>{message}</p>
			{
				subscriber ? (
					<form method="post">
						<p>
							<label>
								Email
								<input type="email" value={email} disabled />
							</label>
						</p>
						<p>
							<label>
								Name
								<input type="text" name="name" value={name} autocomplete="name" />
							</label>
						</p>
						<fieldset>
							<legend>Topics</legend>
							<label>
								<input type="checkbox" name="wantsProjects" checked={wantsProjects} />
								Projects
							</label>
							<label>
								<input type="checkbox" name="wantsThoughts" checked={wantsThoughts} />
								Thoughts
							</label>
						</fieldset>
						<p>
							<button type="submit">Save preferences</button>
						</p>
					</form>
				) : (
					<p><a href="/">Back home</a></p>
				)
			}
		</main>
		<Footer />
	</body>
</html>
