---
export const prerender = false;

import PageLayout from "../layouts/PageLayout.astro";
import {
  InvalidTokenError,
  subscriberService,
} from "../lib/subscriber-service";

const token = Astro.url.searchParams.get("t") ?? "";
if (!token) {
  return Astro.redirect("/");
}

let title = "Manage preferences";
let message = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    await subscriberService.updatePreferences(token, {
      name: String(formData.get("name") ?? ""),
      wantsProjects: formData.get("wantsProjects") === "on",
      wantsThoughts: formData.get("wantsThoughts") === "on",
      wantsOther: formData.get("wantsOther") === "on",
    });
    const preferencesUrl = new URL("/preferences", Astro.url);
    preferencesUrl.searchParams.set("t", token);
    preferencesUrl.searchParams.set("updated", "1");
    return Astro.redirect(preferencesUrl.toString());
  } catch (error) {
    if (error instanceof InvalidTokenError) {
      title = "Invalid link";
      message = "The token is invalid.";
    } else {
      console.error(error);
      title = "Error";
      message = "Something went wrong.";
    }
  }
} else if (Astro.request.method !== "GET") {
  return Astro.redirect("/");
}

let subscriber = null;
try {
  subscriber = await subscriberService.readByToken(token);
} catch (error) {
  if (error instanceof InvalidTokenError) {
    title = "Invalid link";
    message = "The token is invalid.";
  } else {
    throw error;
  }
}

if (subscriber) {
  if (Astro.url.searchParams.get("updated")) {
    message = "Your preferences have been updated.";
  } else if (Astro.url.searchParams.get("confirmed")) {
    title = "You're subscribed";
    message =
      "It means a lot that you want to keep in touch. I'd love to know who's reading, so please add your name, especially if I wouldn't recognize you from your email :) Thanks for subscribing, and please feel free to reply directly to anything I send your way!";
  }
}

const name = subscriber?.name ?? "";
const email = subscriber?.email ?? "";
const wantsProjects = subscriber?.wantsProjects ?? false;
const wantsThoughts = subscriber?.wantsThoughts ?? false;
const wantsOther = subscriber?.wantsOther ?? false;
---

<PageLayout title={title} description={message}>
  <main>
    <h3>{title}</h3>
    <p>{message}</p>
    {
      subscriber ? (
        <form method="post">
          <fieldset class="table">
            <label>
              <span>Email</span>
              <input type="email" value={email} disabled />
            </label>
            <label>
              <span>Name</span>
              <input type="text" name="name" value={name} autocomplete="name" />
            </label>
          </fieldset>
          <fieldset>
            <legend>Email me about...</legend>
            <label>
              <input
                type="checkbox"
                name="wantsProjects"
                checked={wantsProjects}
              />
              Projects
            </label>
            <label>
              <input
                type="checkbox"
                name="wantsThoughts"
                checked={wantsThoughts}
              />
              Thoughts
            </label>
            <label>
              <input type="checkbox" name="wantsOther" checked={wantsOther} />
              Other (Recipes, trips, life updates... not sure yet!)
            </label>
          </fieldset>
          <button type="submit">Save preferences</button>
        </form>
      ) : (
        <a href="/">Back home</a>
      )
    }
  </main>
</PageLayout>

<style>
  p {
    margin-top: 0;
    color: var(--color-tx-muted);
  }

  form {
    margin-top: 2rem;
  }

  label,
  legend {
    color: var(--color-tx-muted);
  }

  label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  fieldset {
    margin: 0;
    margin-bottom: 1rem;
    padding: 0;
    border: 0;
    display: grid;
    gap: 0.5rem;
  }

  .table {
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 1rem;
  }

  .table label {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: center;
  }

  input:not([type="checkbox"]) {
    width: 100%;
    padding: 0.25rem 0;
    border: 0;
    border-bottom: 1px solid var(--color-ui-normal);
    border-radius: 0;
    background: transparent;
    color: var(--color-tx-normal);
    font: inherit;

    &:disabled {
      color: var(--color-tx-muted);
    }

    &:focus {
      border-color: var(--color-action);
      outline: none;
    }
  }

  legend {
    margin-bottom: 0.25rem;
    padding: 0.5rem 0 0 0;
  }

  input[type="checkbox"] {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: var(--color-action);
  }

  button {
    margin-top: 1rem;
    justify-self: start;
    padding: 0.25rem 0.5rem;
    border: none;
    border-radius: 0.25rem;
    background: var(--color-tx-normal);
    color: var(--color-bg-primary);
    cursor: pointer;
    font: inherit;
    transition: background-color 150ms ease;

    &:hover,
    &:focus-visible {
      background: var(--color-action);
      outline: none;
    }
  }
</style>
