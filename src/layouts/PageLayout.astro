---
import Nav from "../components/Nav.astro";
import { SITE_TITLE } from "../consts";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  breadcrumbs?: { title: string; href?: string }[];
  frontmatter?: Props;
}

const pageProps = { ...Astro.props.frontmatter, ...Astro.props };
const { breadcrumbs = [] } = pageProps;
---

<BaseLayout {...pageProps}>
  <header>
    <nav aria-label="Breadcrumb">
      <a href="/">{SITE_TITLE}</a>
      {
        breadcrumbs.map(({ title, href }) => (
          <>
            <span class="separator">/</span>
            {href ? <a href={href}>{title}</a> : <span>{title}</span>}
          </>
        ))
      }
    </nav>
    <Nav />
  </header>
  <slot />
</BaseLayout>

<style>
  body {
    margin: 0 auto;
    width: var(--wrap-normal);
    max-width: var(--wrap-wide);
  }

  header {
    margin-top: 1rem;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  nav {
    color: var(--color-tx-muted);

    a {
      margin: 0;
      border-radius: 0.25rem;
      display: inline-block;
      color: inherit;
      text-decoration: none;

      &:hover,
      &:focus-visible {
        color: var(--color-action);
      }

      &:active {
        background: var(--color-selection);
      }
    }
  }

  .separator {
    margin: 0 0.125rem;
  }
</style>
